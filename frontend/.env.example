# Google Places API Configuration
# Get your API key from: https://console.cloud.google.com/apis/credentials
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Your business's Google Place ID
# Find it at: https://developers.google.com/maps/documentation/places/web-service/place-id
GOOGLE_PLACE_ID=your_google_place_id_here

# reCAPTCHA v3 Configuration
# Get your keys from: https://www.google.com/recaptcha/admin
PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here

# SendGrid Configuration
# Get your API key from: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=your_sendgrid_api_key_here
FROM_EMAIL=noreply@tributestream.com

# SendGrid Dynamic Template IDs
# Create these templates in your SendGrid dashboard: https://mc.sendgrid.com/dynamic-templates
SENDGRID_TEMPLATE_ENHANCED_REGISTRATION=d-10efa11389054692a7dc7d24372f5a49 
SENDGRID_TEMPLATE_BASIC_REGISTRATION=d-d343cf774d45400e94fb64f6c7dbef1b 
SENDGRID_TEMPLATE_INVITATION=d-xxxxxxxxxx
SENDGRID_TEMPLATE_EMAIL_CHANGE=d-c6822b3945214a0393c902e6aef83bff 
SENDGRID_TEMPLATE_PAYMENT_CONFIRMATION=d-8e97780e0680441baa63bc24f51bfea6 
SENDGRID_TEMPLATE_PAYMENT_ACTION=d-9d7d9d813b04495da4e08cf234551cd4 
SENDGRID_TEMPLATE_PAYMENT_FAILURE=d-e2f4eaa19f534911948f8e46d7ddc73f 
SENDGRID_TEMPLATE_CONTACT_SUPPORT=d-54a734ea00114ba2bbfbf849de04f681 
SENDGRID_TEMPLATE_CONTACT_CONFIRMATION=d-4e36e031501e4ab6ac21c5716e14ef08  

# Cloudflare Stream Configuration
# Get your Account ID and API Token from: https://dash.cloudflare.com
# Navigate to: Stream > API Tokens
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_stream_api_token_here

# Cloudflare Stream Webhook Secret
# Subscribe to webhooks using the Stream API (see CLOUDFLARE_WEBHOOK_SETUP.md)
# Or run: ./setup-production-webhook.sh https://yourdomain.com
# The API response will include the webhook secret - copy it here
CLOUDFLARE_WEBHOOK_SECRET=your_webhook_secret_here

# Mux Configuration
# Get your access tokens from: https://dashboard.mux.com/settings/access-tokens
MUX_TOKEN_ID=your_mux_token_id_here
MUX_TOKEN_SECRET=your_mux_token_secret_here

# Mux Webhook Secret
# Get this from: https://dashboard.mux.com/settings/webhooks
# Create webhook pointing to: https://yourdomain.com/api/webhooks/mux
MUX_WEBHOOK_SECRET=your_mux_webhook_signing_secret_here

# Firebase Configuration
# Public (client-side) Firebase config
PUBLIC_FIREBASE_API_KEY=AIzaSyDXaW1yRq0bj2eMFXtpLRAXCEoXFeoXO3U
PUBLIC_FIREBASE_AUTH_DOMAIN=tributestreamlive.firebaseapp.com
PUBLIC_FIREBASE_PROJECT_ID=tributestreamlive
PUBLIC_FIREBASE_STORAGE_BUCKET=tributestreamlive.firebasestorage.app
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1052723763398
PUBLIC_FIREBASE_APP_ID=1:1052723763398:web:299d27908ec08d9b4e5fc7

 PRIVATE_FIREBASE_STORAGE_BUCKET=tributestreamlive.firebasestorage.app
# PRIVATE_FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}

# Set to 'true' to use production Firebase in dev mode (skip emulators)
PUBLIC_USE_PRODUCTION=false
